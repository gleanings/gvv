{
  "name": "gvv",
  "type": "module",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "local": "node ./scripts/build-local.js",
    "build": "jja rm dist && rollup --config rollup.config.js && pnpm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "dev": "pnpm run build && gvv_dev=all node --trace-warnings dist/bin.js",
    "diff": "jja pkg -d 淘宝",
    "lint": "eslint . --fix",
    "beautify": "prettier . --write",
    "push:version": "pnpm run build && node dist/bin.js kind=version",
    "push": "pnpm run build && node dist/bin.js",
    "vjj": "jja cls && vjj -b",
    "prepublishOnly": "jja cls && pjj"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.5.0",
    "@vvi/check-version": "^1.1.2",
    "@vvi/rollup-external": "^1.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "jja": "^2.5.5",
    "pjj": "^1.0.7",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-license": "^3.7.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vjj": "^1.0.14"
  },
  "dependencies": {
    "@vvi/command": "^4.0.2",
    "@vvi/is": "^2.0.7",
    "@vvi/log": "^1.1.6",
    "@vvi/node": "^5.0.1",
    "@vvi/pen": "^3.0.3",
    "@vvi/utils": "^2.1.0"
  }
}