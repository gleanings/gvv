{
  "name": "gvv",
  "type": "module",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "local": "node ./scripts/build-local.js",
    "build": "jja rm dist && rollup --config rollup.config.js && pnpm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "dev": "pnpm run build && gvv_dev=all node --trace-warnings dist/bin.js",
    "diff": "jja pkg -d 淘宝",
    "lint": "eslint . --fix",
    "beautify": "prettier . --write",
    "push:version": "pnpm run build && node dist/bin.js kind=version",
    "push": "pnpm run build && node dist/bin.js",
    "vjj": "jja cls && vjj -b",
    "prepublishOnly": "jja cls && pjj"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@rollup/plugin-commonjs": "^29.0.3",
