{
  "name": "gvv",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "local": "node ./scripts/build-local.js",
    "build": "jja cls rm dist && rollup --config rollup.config.js && pnpm run clean:package",
    "clean:package": "node scripts/clean-package-json.js",
    "dev": "pnpm run build &&gvv_dev=all node  --trace-warnings dist/bin.mjs",
    "diff": "jja pkg -d 淘宝",
    "lint": "eslint . --fix",
    "beautify": "prettier . --write",
    "push:version": "pnpm run build && node dist/bin.mjs kind=version",
    "push": "pnpm run build && node dist/bin.mjs",
    "vjj": "jja cls && vjj -b",
    "prepublishOnly": "jja cls && pjj"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@qqi/check-version": "^1.1.0",
    "@qqi/log": "^1.0.0",
    "@qqi/rollup-external": "^1.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.8",
    "a-command": "^3.0.0",
    "a-js-tools": "^2.0.1",
    "a-node-tools": "^4.2.20",
    "a-type-of-js": "^2.0.0",
    "color-pen": "^3.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.0.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jja": "^2.4.0",
    "lint-staged": "^16.2.7",
    "pjj": "^1.0.5",
    "prettier": "^3.7.4",
    "rollup": "^4.55.1",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-license": "^3.6.0",
    "tslib": "^2.8.1",
